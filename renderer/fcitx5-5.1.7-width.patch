+void XCBInputWindow::observeCaret(InputContext *ic, bool fresh) {
+    const Rect rect = ic->cursorRect();
+    // An unset rectangle may follow even a valid caret near the origin.
+    if (!fresh && rect == Rect() && acceptedCaret_ != Rect()) {
+        caretTimer_.reset();
+        return;
+    }
+    if (fresh || rect == acceptedCaret_ || sameCaretLine(rect, acceptedCaret_)) {
+        caretTimer_.reset();
+        acceptedCaret_ = rect;
+        return;
+    }
+    // Confirm a real relocation before moving the popup.
+    if (caretTimer_ && caretTimer_->isEnabled() && sameCaretLine(rect, proposedCaret_)) {
+        proposedCaret_ = rect;
+        return;
+    }
+    proposedCaret_ = rect;
+    caretTimer_ = parent_->instance()->eventLoop().addTimeEvent(
+        CLOCK_MONOTONIC, now(CLOCK_MONOTONIC) + 42000, 1000,
+        [this](EventSourceTime *, uint64_t) {
+            if (auto *owner = inputContext_.get(); owner && owner->hasFocus() && visible()) {
+                if (owner->cursorRect() == proposedCaret_) {
+                    acceptedCaret_ = proposedCaret_;
+                    update(owner);
+                }
+            }
+            return true;
+        });
