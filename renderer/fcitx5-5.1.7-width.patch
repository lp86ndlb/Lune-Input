+int XCBInputWindow::transitionTo(int width, bool allowAnimation, bool deleting) {
+    const bool running = resizeTimer_ && resizeTimer_->isEnabled();
+    if (width == targetWidth_) {
+        return running ? displayedWidth_ : width;
+    }
+    const auto nowUsec = now(CLOCK_MONOTONIC);
+    uint64_t duration = 1000ULL * *parent_->config().candidateResizeDuration;
+    const int delta = width - displayedWidth_;
+    const double scale = (dpi_ > 0 ? dpi_ : 96) / 96.0;
+    double slope = 0;
+    if (running && deleting && delta && endTime_ > startTime_) {
+        // Match the previous spring's velocity on another Backspace.
+        const double span = endTime_ - startTime_;
+        const double t = std::clamp((nowUsec - startTime_) / span, 0.0, 1.0);
+        const double rate = 25 * t * std::exp(-5 * t) / (1 - 6 * std::exp(-5.0)) +
+                            initialSlope_ * (1-t) * (1-t) * (1-4*t);
+        slope = std::clamp(rate * (targetWidth_ - startWidth_) / span * duration / delta, 0.0, 2.0);
+    } else if (running) {
+        duration = endTime_ > nowUsec ? endTime_ - nowUsec : 0;
+    }
+    startWidth_ = displayedWidth_;
+    targetWidth_ = width;
+    initialSlope_ = slope;
+    resizeTimer_.reset();
+    const bool small = deleting ? std::abs(delta) < std::lround(12 * scale) :
+        (std::abs(delta) < std::lround(88 * scale) || 8LL * std::abs(delta) < startWidth_);
+    if (!useShape_ || !allowAnimation || !duration || !delta || (!running && small) ||
+        (!deleting && !running && startTime_ && nowUsec - startTime_ < 400000)) {
+        return width;
+    }
+    // Present the first contraction together with the new candidate row.
+    const auto lead = deleting ? std::min<uint64_t>(12000, duration / 4) : 0;
+    startTime_ = nowUsec - lead;
+    endTime_ = startTime_ + duration;
+    resizeTimer_ = parent_->instance()->eventLoop().addTimeEvent(
+        CLOCK_MONOTONIC, nowUsec + 6000, 1000,
+        [this, duration](EventSourceTime *timer, uint64_t) {
+            auto *ic = inputContext_.get();
+            if (!ic || !visible()) {
+                return true;
+            }
+            const double progress = std::min(1.0,
+                double(now(CLOCK_MONOTONIC) - startTime_) / duration);
+            const int w = springWidth(progress);
+            if (w != displayedWidth_ || progress >= 1.0) {
+                drawFrame(w, this->height(), false, progress < 1.0,
+                          progress >= 1.0 && recoverAfterResize_);
+            }
+            if (progress < 1.0) {
+                timer->setNextInterval(8000);
+                timer->setOneShot();
+            }
+            return true;
+        });
+    return springWidth(double(lead) / duration);
+}
