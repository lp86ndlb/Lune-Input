+int XCBInputWindow::springWidth(double t) const {
+    const double phase = 5.0 * t;
+    const double remaining = 1.0 - t;
+    const double eased = (1.0 - (1.0 + phase) * std::exp(-phase)) /
+                         (1.0 - 6.0 * std::exp(-5.0)) +
+                         initialSlope_ * t * remaining * remaining * remaining;
+    return startWidth_ + std::lround((targetWidth_ - startWidth_) * eased);
+}
 
