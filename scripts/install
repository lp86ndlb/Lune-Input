#!/usr/bin/env python3
"""Install Lune for the current user. Changed files are backed up before replacement."""
import argparse
from datetime import datetime
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state")
APP_ID = "io.github.lp86ndlb.LuneInput.Settings"


def install():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--with-renderer", action="store_true", help="also install the built X11 renderer")
    parser.add_argument("--with-integration", action="store_true",
                        help="also install the Lune input features and tray submenu")
    parser.add_argument("--upgrade-integration", action="store_true",
                        help="add or update the integration on an existing Lune installation")
    args = parser.parse_args()
    fcitx = DATA / "fcitx5"
    files = {}

    def include(folder, names, target):
        for name in names.split():
            files[target / name] = ROOT / folder / name

    if not args.upgrade_integration:
        include("fcitx5", "config profile", CONFIG / "fcitx5")
        include("fcitx5/conf", "classicui.conf rime.conf pinyin.conf chttrans.conf punctuation.conf notifications.conf",
                CONFIG / "fcitx5/conf")
        include("rime", "default.custom.yaml luna_pinyin_simp.custom.yaml local_terms.schema.yaml "
                "local_terms.dict.yaml local_it.dict.yaml local_long.dict.yaml local_symbols.yaml essay.txt "
                "melt_eng.schema.yaml melt_eng.dict.yaml", fcitx / "rime")
        include("rime/en_dicts", "en.dict.yaml en_ext.dict.yaml cn_en.txt", fcitx / "rime/en_dicts")
        theme = "themes/catppuccin-mocha-mauve"
        include(theme, "theme.conf highlight.svg panel.svg arrow.png radio.png", fcitx / theme)
        include("inputmethod", "rime.conf", fcitx / "inputmethod")
        include("icons", "fcitx-rime.svg fcitx-rime-rounded-white.svg org.fcitx.Fcitx5.fcitx-rime.svg",
                DATA / "icons/Yaru-magenta/24x24/apps")
        include("icons", "fcitx-rime-rounded-white.svg", DATA / "icons/hicolor/scalable/apps")
        include("scripts", "update-rime-it-dict", HOME / ".local/bin")

    schema_name = "luna_pinyin_simp.schema.yaml"
    schema_path = fcitx / "rime" / schema_name
    original = schema_path if schema_path.exists() else Path("/usr/share/rime-data") / schema_name
    schema = original.read_text()
    layers = ["lune_integration:/patch?", "lune_preferences:/patch?"]
    # Patch the complete schema so Ubuntu's translators and processors are preserved.
    if re.search(r"^__patch:", schema, re.MULTILINE):
        import yaml
        document = yaml.safe_load(schema)
        existing = document["__patch"]
        steps = list(existing) if isinstance(existing, list) else [existing]
        missing = [ref for ref in layers if ref not in steps]
        if missing:
            document["__patch"] = steps + missing
            schema = yaml.safe_dump(document, sort_keys=False, allow_unicode=True)
    else:
        schema = schema.rstrip() + "\n\n__patch:\n" + "".join(
            f"  - {ref}\n" for ref in ["luna_pinyin_simp.custom:/patch?", *layers])
    files[schema_path] = schema.encode()
    settings = fcitx / "lune/settings.py"
    files[settings] = ROOT / "scripts/lune-settings"
    icon_theme = DATA / "icons/hicolor"
    app_icon = icon_theme / "scalable/apps" / f"{APP_ID}.svg"
    files[app_icon] = ROOT / "icons" / app_icon.name
    escaped = re.sub(r'(["`$\\])', r'\\\1', str(settings)).replace("%", "%%")
    command = escaped.replace("\\", "\\\\")
    files[DATA / "applications" / f"{APP_ID}.desktop"] = (
        "[Desktop Entry]\nType=Application\nName=Lune\n"
        "GenericName=Input Method Settings\nGenericName[zh_CN]=输入法设置\n"
        f'Exec=/usr/bin/python3 "{command}"\nIcon={APP_ID}\n'
        "Categories=Settings;\nKeywords=Rime;Fcitx;Pinyin;\n"
        "Keywords[zh_CN]=Rime;Fcitx;拼音;输入法;设置;\n"
    ).encode()
    if args.with_integration or args.upgrade_integration:
        library = HOME / ".local/lib/fcitx5/lune"
        include("build", "librime-lune.so librime-select.so", library)
        include("rime", "lune_integration.yaml", fcitx / "rime")
        vendor = Path("/usr/share/fcitx5/addon/rime.conf").read_text()
        entry, count = re.subn(r"^Library=export:librime$", lambda _: f"Library=export:{library}/librime-select",
                               vendor, flags=re.MULTILINE)
        if count != 1:
            parser.exit(1, "无法识别系统 Rime 插件描述。\n")
        files[fcitx / "addon/rime.conf"] = entry.encode()
    if args.with_renderer:
        library = HOME / ".local/lib/fcitx5/candidate-width"
        include("build", "libclassicui-motion.so libclassicui-select.so", library)
        vendor = Path("/usr/share/fcitx5/addon/classicui.conf").read_text()
        entry, count = re.subn(r"^Library=.*$", lambda _: f"Library={library}/libclassicui-select",
                               vendor, flags=re.MULTILINE)
        if count != 1:
            parser.exit(1, "无法识别系统 Classic UI 插件描述。\n")
        files[fcitx / "addon/classicui.conf"] = entry.encode()
    for src in files.values():
        if isinstance(src, Path) and not src.is_file():
            parser.exit(1, f"找不到 {src}。输入集成请先运行 scripts/build-integration，动画组件请先运行 scripts/build-renderer。\n")

    backup = STATE / "lune-input/backups" / datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    for dest, src in files.items():
        data = src.read_bytes() if isinstance(src, Path) else src
        if dest.is_file() and dest.read_bytes() == data:
            continue
        if dest.exists() or dest.is_symlink():
            saved = backup / dest.relative_to(dest.anchor)
            saved.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            shutil.copy2(dest, saved, follow_symlinks=False)
        dest.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(dir=dest.parent, delete=False) as handle:
            tmp = Path(handle.name)
            try:
                handle.write(data)
                handle.flush()
                tmp.chmod(0o755 if dest.name == "update-rime-it-dict" else 0o644)
                tmp.replace(dest)
            finally:
                tmp.unlink(missing_ok=True)
        if dest == app_icon:
            os.utime(icon_theme)
            updater = shutil.which("gtk-update-icon-cache")
            if updater and (icon_theme / "icon-theme.cache").is_file():
                subprocess.run([updater, "-f", "-t", "-q", icon_theme], check=False)
    print("已安装到当前用户目录。")
    if backup.exists():
        print(f"本次覆盖前的文件备份在 {backup}")


if __name__ == "__main__":
    install()
